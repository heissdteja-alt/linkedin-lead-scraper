# Copia este archivo a ".env" y rellena los valores.

# Serper.dev -> tu API key de https://serper.dev/api-key
SERPER_API_KEY=

# Apify -> tu token de https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Google Sheets: ID del spreadsheet donde se guardan los prospectos (esta en la URL del Sheet)
GOOGLE_SHEET_ID=
SHEET_TAB_CALIFICADOS=Prospectos
SHEET_TAB_RECHAZADOS=rechazados

# Flask
FLASK_SECRET_KEY=cambia-esto-por-algo-aleatorio
FLASK_PORT=5001

# Ruta al archivo client_secret.json descargado de Google Cloud Console (OAuth client,
# tipo "Web application", con http://localhost:5001/oauth2callback en Authorized redirect URIs)
GOOGLE_CLIENT_SECRETS_FILE=client_secret.json
